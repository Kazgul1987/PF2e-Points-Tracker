{{#if hasTracker}}
  <div class="influence-tab" data-influence-tab>
    <header class="influence-tab__header">
      <h2 class="points-tracker__section-title">
        {{localize "PF2E.PointsTracker.Influence.PanelTitle"}}
      </h2>
      {{#if canCreate}}
        <button type="button" class="points-tracker__button" data-action="import-influence-npcs">
          <i class="fas fa-file-import" aria-hidden="true"></i>
          {{localize "PF2E.PointsTracker.Influence.Import"}}
        </button>
        <button type="button" class="points-tracker__button" data-action="create-influence-npc">
          <i class="fas fa-plus" aria-hidden="true"></i>
          {{localize "PF2E.PointsTracker.Influence.CreateNpc"}}
        </button>
      {{/if}}
    </header>

    {{#if hasNpcs}}
      <div class="influence-npc-list">
        {{#each npcs as |npc|}}
          <article class="influence-npc" data-npc-id="{{npc.id}}">
            <header class="influence-npc__header">
              <div class="influence-npc__heading">
                <div
                  class="influence-npc__portrait{{#unless npc.img}} is-empty{{/unless}}{{#unless ../isGM}} is-readonly{{/unless}}"
                  data-influence-portrait
                  {{#if ../isGM}}
                    role="button"
                    tabindex="0"
                    data-dropzone="influence-portrait"
                    data-action="select-influence-portrait"
                    aria-label="{{localize 'PF2E.PointsTracker.Influence.NpcPortraitBrowse'}}"
                    title="{{localize 'PF2E.PointsTracker.Influence.NpcPortraitBrowse'}}"
                  {{/if}}
                >
                  {{#if npc.img}}
                    <img
                      src="{{npc.img}}"
                      alt="{{localize 'PF2E.PointsTracker.Influence.NpcPortraitAlt' name=npc.name}}"
                    />
                    {{#if ../isGM}}
                      <button
                        type="button"
                        class="influence-npc__portrait-clear"
                        data-action="clear-influence-portrait"
                        title="{{localize 'PF2E.PointsTracker.Influence.NpcPortraitClear'}}"
                        aria-label="{{localize 'PF2E.PointsTracker.Influence.NpcPortraitClear'}}"
                      >
                        <i class="fas fa-times" aria-hidden="true"></i>
                      </button>
                    {{/if}}
                  {{else if ../isGM}}
                    <span class="influence-npc__portrait-hint">
                      {{localize "PF2E.PointsTracker.Influence.NpcPortraitHint"}}
                    </span>
                  {{/if}}
                </div>
                <div class="influence-npc__title">
                  <h3 class="influence-npc__name">{{npc.name}}</h3>
                  {{#if npc.hasTraits}}
                    <ul class="influence-npc__traits" aria-label="{{localize "PF2E.PointsTracker.Influence.TraitsHeader"}}">
                      {{#each npc.traits as |trait|}}
                        <li class="influence-npc__trait">{{trait}}</li>
                      {{/each}}
                    </ul>
                  {{/if}}
                  {{#if npc.updatedAtFormatted}}
                    <p class="influence-npc__updated">
                      {{localize "PF2E.PointsTracker.Influence.LastUpdated"}} {{npc.updatedAtFormatted}}
                    </p>
                  {{/if}}
                </div>
              </div>
              <div class="influence-npc__actions">
                <button
                  type="button"
                  data-action="toggle-influence-npc"
                  aria-expanded="{{#unless npc.isCollapsed}}true{{else}}false{{/unless}}"
                >
                  {{#if npc.isCollapsed}}
                    <i class="fas fa-angle-down" aria-hidden="true"></i>
                    {{localize "PF2E.PointsTracker.Influence.ExpandDetails"}}
                  {{else}}
                    <i class="fas fa-angle-up" aria-hidden="true"></i>
                    {{localize "PF2E.PointsTracker.Influence.CollapseDetails"}}
                  {{/if}}
                </button>
                <button type="button" data-action="edit-influence-npc">
                  <i class="fas fa-edit" aria-hidden="true"></i>
                  {{localize "PF2E.PointsTracker.Influence.Edit"}}
                </button>
                <button type="button" data-action="manage-influence-skills">
                  <i class="fas fa-list" aria-hidden="true"></i>
                  {{localize "PF2E.PointsTracker.Influence.ManageSkills"}}
                </button>
                {{#if ../isGM}}
                  <button
                    type="button"
                    data-action="toggle-influence-visibility"
                    title="{{localize 'PF2E.PointsTracker.Influence.InfluenceVisibilityHelp'}}"
                  >
                    <i
                      class="fas {{#if npc.showInfluenceSkillsToPlayers}}fa-eye{{else}}fa-eye-slash{{/if}}"
                      aria-hidden="true"
                    ></i>
                    {{#if npc.showInfluenceSkillsToPlayers}}
                      {{localize "PF2E.PointsTracker.Influence.HideInfluenceFromPlayers"}}
                    {{else}}
                      {{localize "PF2E.PointsTracker.Influence.ShowInfluenceToPlayers"}}
                    {{/if}}
                  </button>
                {{/if}}
                <button type="button" data-action="manage-influence-thresholds">
                  <i class="fas fa-flag" aria-hidden="true"></i>
                  {{localize "PF2E.PointsTracker.Influence.ManageThresholds"}}
                </button>
                <button type="button" class="points-tracker__button--danger" data-action="delete-influence-npc">
                  <i class="fas fa-trash" aria-hidden="true"></i>
                  {{localize "PF2E.PointsTracker.Influence.Delete"}}
                </button>
              </div>
            </header>

            <section class="influence-npc__progress" aria-label="{{localize "PF2E.PointsTracker.Influence.Progress"}}">
              <div class="influence-npc__progress-top">
                <span class="influence-npc__value">{{npc.currentInfluence}}</span>
                {{#if npc.maxInfluence}}
                  <span class="influence-npc__max">/ {{npc.maxInfluence}}</span>
                {{/if}}
              </div>
              <div class="influence-npc__progress-bar" role="progressbar" aria-valuenow="{{npc.progressPercent}}" aria-valuemin="0" aria-valuemax="100">
                <div class="influence-npc__progress-track">
                  <div class="influence-npc__progress-fill" style="width: {{npc.progressPercent}}%;"></div>
                </div>
                {{#if npc.hasThresholds}}
                  <div class="influence-npc__progress-markers">
                    {{#each npc.thresholds as |threshold|}}
                      <span
                        class="influence-npc__progress-marker{{#if threshold.isUnlocked}} is-unlocked{{/if}}{{#if threshold.isRevealed}} is-revealed{{/if}}"
                        style="left: {{threshold.markerPercent}}%;"
                        title="{{threshold.pointsLabel}}"
                        aria-label="{{threshold.pointsLabel}}"
                        role="img"
                        tabindex="0"
                      ></span>
                    {{/each}}
                  </div>
                {{/if}}
              </div>
              <div class="influence-npc__labels">
                <span class="influence-npc__label">{{npc.maxInfluenceLabel}}</span>
              </div>
              <div class="influence-npc__buttons">
                <button type="button" data-action="adjust-influence" data-delta="-1" {{#unless npc.canDecrease}}disabled{{/unless}}>
                  -1
                </button>
                <button type="button" data-action="adjust-influence" data-delta="1" {{#unless npc.canIncrease}}disabled{{/unless}}>
                  +1
                </button>
                <button type="button" data-action="adjust-influence" data-delta="2" {{#unless npc.canIncrease}}disabled{{/unless}}>
                  +2
                </button>
                <button type="button" data-action="set-influence">
                  {{localize "PF2E.PointsTracker.Influence.Set"}}
                </button>
              </div>
            </section>

            <div class="influence-npc__body{{#if npc.isCollapsed}} is-collapsed{{/if}}">
              {{#if npc.hasSkillDcs}}
                <section class="influence-npc__skills">
                  <h4>{{localize "PF2E.PointsTracker.Influence.SkillHeader"}}</h4>
                  <ul>
                    {{#each npc.skillDcs as |skill|}}
                      <li>
                        {{#if skill.inlineHtml}}
                          {{{skill.inlineHtml}}}
                        {{else}}
                          {{skill.label}}
                        {{/if}}
                      </li>
                    {{/each}}
                  </ul>
                </section>
              {{/if}}

              {{#if npc.hasThresholds}}
                <section class="influence-npc__thresholds">
                  <h4>{{localize "PF2E.PointsTracker.Influence.ThresholdHeader"}}</h4>
                  <ul>
                    {{#each npc.thresholds as |threshold|}}
                      <li class="influence-npc__threshold" data-threshold-id="{{threshold.id}}">
                        <div class="influence-npc__threshold-info">
                          <span class="influence-npc__threshold-points">{{threshold.pointsLabel}}</span>
                          {{#if threshold.isUnlocked}}
                            <span class="tag tag--success">{{localize "PF2E.PointsTracker.Influence.ThresholdUnlocked"}}</span>
                          {{else}}
                            <span class="tag tag--muted">{{localize "PF2E.PointsTracker.Influence.ThresholdLocked"}}</span>
                          {{/if}}
                          {{#if threshold.isRevealed}}
                            <span class="tag tag--primary">{{localize "PF2E.PointsTracker.Influence.ThresholdRevealed"}}</span>
                          {{else}}
                            <span class="tag tag--muted">{{localize "PF2E.PointsTracker.Influence.ThresholdHidden"}}</span>
                          {{/if}}
                        </div>
                        {{#if ../../isGM}}
                          <div class="influence-npc__threshold-actions">
                            <button
                              type="button"
                              data-action="reveal-influence-threshold"
                              {{#unless threshold.canReveal}}disabled{{/unless}}
                            >
                              {{localize "PF2E.PointsTracker.Influence.RevealThreshold"}}
                            </button>
                            {{#if threshold.canResend}}
                              <button type="button" data-action="resend-influence-threshold">
                                {{localize "PF2E.PointsTracker.Influence.ThresholdResend"}}
                              </button>
                            {{/if}}
                            {{#if threshold.canHide}}
                              <button type="button" data-action="hide-influence-threshold">
                                {{localize "PF2E.PointsTracker.Influence.HideThreshold"}}
                              </button>
                            {{/if}}
                          </div>
                          {{#if threshold.hasPlayerText}}
                            <div class="influence-npc__threshold-player">
                              <strong>{{localize "PF2E.PointsTracker.Influence.ThresholdPlayerText"}}</strong>
                              {{{threshold.playerTextHtml}}}
                            </div>
                          {{/if}}
                          {{#if threshold.hasGmText}}
                            <div class="influence-npc__threshold-gm">
                              <strong>{{localize "PF2E.PointsTracker.Influence.ThresholdGmText"}}</strong>
                              {{{threshold.gmTextHtml}}}
                            </div>
                          {{/if}}
                          {{#if threshold.hasReward}}
                            <div class="influence-npc__threshold-reward">
                              <strong>{{localize "PF2E.PointsTracker.Influence.ThresholdRewardHeading"}}</strong>
                              {{{threshold.rewardHtml}}}
                            </div>
                          {{/if}}
                        {{else}}
                          {{#if threshold.showToPlayers}}
                            {{#if threshold.hasPlayerText}}
                              <div class="influence-npc__threshold-player">{{{threshold.playerTextHtml}}}</div>
                            {{/if}}
                            {{#if threshold.hasReward}}
                              <div class="influence-npc__threshold-reward">
                                <strong>{{localize "PF2E.PointsTracker.Influence.ThresholdRewardHeading"}}</strong>
                                {{{threshold.rewardHtml}}}
                              </div>
                            {{/if}}
                          {{/if}}
                        {{/if}}
                      </li>
                    {{/each}}
                  </ul>
                </section>
              {{/if}}

              {{#if npc.hasBackground}}
                <section class="influence-npc__background">
                  <h4>{{localize "PF2E.PointsTracker.Influence.BackgroundHeader"}}</h4>
                  <div class="influence-npc__background-text">{{{npc.backgroundHtml}}}</div>
                </section>
              {{/if}}

              {{#if npc.hasAppearance}}
                <section class="influence-npc__appearance">
                  <h4>{{localize "PF2E.PointsTracker.Influence.AppearanceHeader"}}</h4>
                  <div class="influence-npc__appearance-text">{{{npc.appearanceHtml}}}</div>
                </section>
              {{/if}}

              {{#if npc.hasPersonality}}
                <section class="influence-npc__personality">
                  <h4>{{localize "PF2E.PointsTracker.Influence.PersonalityHeader"}}</h4>
                  <div class="influence-npc__personality-text">{{{npc.personalityHtml}}}</div>
                </section>
              {{/if}}

              {{#if npc.hasDiscoveryChecks}}
                <section class="influence-npc__discovery">
                  <h4>{{localize "PF2E.PointsTracker.Influence.DiscoveryChecksHeader"}}</h4>
                  {{#if npc.hasDiscoveryCheckList}}
                    <ul class="influence-npc__discovery-list">
                      {{#each npc.discoveryChecks as |check|}}
                        <li>
                          {{#if check.inlineHtml}}
                            {{{check.inlineHtml}}}
                          {{else}}
                            {{check.label}}
                          {{/if}}
                        </li>
                      {{/each}}
                    </ul>
                  {{/if}}
                  {{#if npc.hasDiscoveryNotes}}
                    <div class="influence-npc__discovery-notes">{{{npc.discoveryNotesHtml}}}</div>
                  {{/if}}
                </section>
              {{/if}}

              {{#if npc.hasInfluenceChecks}}
                <section class="influence-npc__influence">
                  <h4>{{localize "PF2E.PointsTracker.Influence.InfluenceChecksHeader"}}</h4>
                  {{#if npc.hasInfluenceCheckList}}
                    <ul class="influence-npc__influence-list">
                      {{#each npc.influenceChecks as |check|}}
                        <li>
                          {{#if check.inlineHtml}}
                            {{{check.inlineHtml}}}
                          {{else}}
                            {{check.label}}
                          {{/if}}
                        </li>
                      {{/each}}
                    </ul>
                  {{/if}}
                  {{#if npc.hasInfluenceNotes}}
                    <div class="influence-npc__influence-notes">{{{npc.influenceNotesHtml}}}</div>
                  {{/if}}
                </section>
              {{/if}}

              {{#if npc.penalty}}
                <section class="influence-npc__penalty">
                  <h4>{{localize "PF2E.PointsTracker.Influence.PenaltyHeader"}}</h4>
                  <div class="influence-npc__penalty-text">{{{npc.penaltyHtml}}}</div>
                </section>
              {{/if}}

              {{#if npc.notes}}
                <section class="influence-npc__notes">
                  <h4>{{localize "PF2E.PointsTracker.Influence.NotesHeader"}}</h4>
                  <div class="influence-npc__notes-text">{{{npc.notesHtml}}}</div>
                </section>
              {{/if}}

              <div class="influence-npc__log-actions">
                <button type="button" data-action="add-influence-log-entry">
                  <i class="fas fa-pen" aria-hidden="true"></i>
                  {{localize "PF2E.PointsTracker.Influence.AddNpcLog"}}
                </button>
              </div>

              {{#if npc.hasLogEntries}}
                <section class="influence-npc__log" data-influence-npc-log data-npc-id="{{npc.id}}">
                  <header class="influence-npc__log-header">
                    <h4>{{localize "PF2E.PointsTracker.Influence.NpcLogHeader"}}</h4>
                    <button
                      type="button"
                      data-action="toggle-influence-npc-log"
                      aria-expanded="{{#unless npc.isLogCollapsed}}true{{else}}false{{/unless}}"
                      data-label-expanded="{{localize "PF2E.PointsTracker.Influence.CollapseNpcLog"}}"
                      data-label-collapsed="{{localize "PF2E.PointsTracker.Influence.ExpandNpcLog"}}"
                      title="{{#if npc.isLogCollapsed}}{{localize "PF2E.PointsTracker.Influence.ExpandNpcLog"}}{{else}}{{localize "PF2E.PointsTracker.Influence.CollapseNpcLog"}}{{/if}}"
                      aria-label="{{#if npc.isLogCollapsed}}{{localize "PF2E.PointsTracker.Influence.ExpandNpcLog"}}{{else}}{{localize "PF2E.PointsTracker.Influence.CollapseNpcLog"}}{{/if}}"
                    >
                      <i
                        class="fas {{#if npc.isLogCollapsed}}fa-angle-down{{else}}fa-angle-up{{/if}}"
                        aria-hidden="true"
                        data-toggle-icon
                      ></i>
                      <span data-label>
                        {{#if npc.isLogCollapsed}}
                          {{localize "PF2E.PointsTracker.Influence.ExpandNpcLog"}}
                        {{else}}
                          {{localize "PF2E.PointsTracker.Influence.CollapseNpcLog"}}
                        {{/if}}
                      </span>
                    </button>
                  </header>
                  <div
                    class="influence-log__body{{#if npc.isLogCollapsed}} is-collapsed{{/if}}"
                    data-influence-npc-log-body
                  >
                    <ul>
                      {{#each npc.logEntries as |entry|}}
                        <li class="influence-log__entry" data-log-id="{{entry.id}}" data-npc-id="{{entry.npcId}}">
                          <span class="influence-log__timestamp">{{entry.timestampFormatted}}</span>
                          <span class="influence-log__delta">{{entry.deltaLabel}}</span>
                          {{#if entry.reason}}
                            <span class="influence-log__reason">{{entry.reason}}</span>
                          {{/if}}
                          {{#if entry.note}}
                            <span class="influence-log__note">{{entry.note}}</span>
                          {{/if}}
                          {{#if entry.totalLabel}}
                            <span class="influence-log__total">{{entry.totalLabel}}</span>
                          {{/if}}
                          {{#if entry.userName}}
                            <span class="influence-log__user">{{entry.userName}}</span>
                          {{/if}}
                          <div class="influence-log__actions">
                            <button type="button" data-action="edit-influence-log-entry">
                              {{localize "PF2E.PointsTracker.Influence.Edit"}}
                            </button>
                            <button type="button" data-action="delete-influence-log-entry">
                              {{localize "PF2E.PointsTracker.Influence.Delete"}}
                            </button>
                          </div>
                        </li>
                      {{/each}}
                    </ul>
                  </div>
                </section>
              {{/if}}
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="influence-tab__empty">{{localize "PF2E.PointsTracker.Influence.NoNpcs"}}</p>
    {{/if}}

    <section class="influence-tab__log" data-influence-log data-influence-session-log>
      <header class="influence-tab__log-header">
        <h3>{{localize "PF2E.PointsTracker.Influence.SessionLog"}}</h3>
        <div class="influence-tab__log-actions">
          <button
            type="button"
            data-action="toggle-influence-session-log"
            aria-expanded="{{#unless isSessionLogCollapsed}}true{{else}}false{{/unless}}"
            data-label-expanded="{{localize "PF2E.PointsTracker.Influence.CollapseSessionLog"}}"
            data-label-collapsed="{{localize "PF2E.PointsTracker.Influence.ExpandSessionLog"}}"
            title="{{#if isSessionLogCollapsed}}{{localize "PF2E.PointsTracker.Influence.ExpandSessionLog"}}{{else}}{{localize "PF2E.PointsTracker.Influence.CollapseSessionLog"}}{{/if}}"
            aria-label="{{#if isSessionLogCollapsed}}{{localize "PF2E.PointsTracker.Influence.ExpandSessionLog"}}{{else}}{{localize "PF2E.PointsTracker.Influence.CollapseSessionLog"}}{{/if}}"
          >
            <i
              class="fas {{#if isSessionLogCollapsed}}fa-angle-down{{else}}fa-angle-up{{/if}}"
              aria-hidden="true"
              data-toggle-icon
            ></i>
            <span data-label>
              {{#if isSessionLogCollapsed}}
                {{localize "PF2E.PointsTracker.Influence.ExpandSessionLog"}}
              {{else}}
                {{localize "PF2E.PointsTracker.Influence.CollapseSessionLog"}}
              {{/if}}
            </span>
          </button>
          <button type="button" data-action="add-influence-log-entry">
            <i class="fas fa-plus" aria-hidden="true"></i>
            {{localize "PF2E.PointsTracker.Influence.AddLogEntry"}}
          </button>
        </div>
      </header>
      <div
        class="influence-tab__log-body{{#if isSessionLogCollapsed}} is-collapsed{{/if}}"
        data-influence-session-log-body
      >
        {{#if hasLog}}
          <ul class="influence-log__list">
            {{#each log as |entry|}}
              <li class="influence-log__entry" data-log-id="{{entry.id}}" data-npc-id="{{entry.npcId}}">
                <span class="influence-log__timestamp">{{entry.timestampFormatted}}</span>
                <span class="influence-log__npc">{{entry.npcName}}</span>
                <span class="influence-log__delta">{{entry.deltaLabel}}</span>
                <span class="influence-log__type">{{entry.typeLabel}}</span>
                {{#if entry.reason}}
                  <span class="influence-log__reason">{{entry.reason}}</span>
                {{/if}}
                {{#if entry.note}}
                  <span class="influence-log__note">{{entry.note}}</span>
                {{/if}}
                {{#if entry.totalLabel}}
                  <span class="influence-log__total">{{entry.totalLabel}}</span>
                {{/if}}
                {{#if entry.userName}}
                  <span class="influence-log__user">{{entry.userName}}</span>
                {{/if}}
                <div class="influence-log__actions">
                  <button type="button" data-action="edit-influence-log-entry">
                    {{localize "PF2E.PointsTracker.Influence.Edit"}}
                  </button>
                  <button type="button" data-action="delete-influence-log-entry">
                    {{localize "PF2E.PointsTracker.Influence.Delete"}}
                  </button>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="influence-log__empty">{{localize "PF2E.PointsTracker.Influence.NoLogEntries"}}</p>
        {{/if}}
      </div>
    </section>
  </div>
{{else}}
  <p class="influence-tab__disabled">{{localize "PF2E.PointsTracker.Influence.Disabled"}}</p>
{{/if}}
